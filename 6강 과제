using UnityEngine;

public class DamageSimulator : MonoBehaviour
{
    public TextMeshProUGUI statusDisplay;
    public TextMeshProUGUI logDisplay;
    public TextMeshProUGUI resultDisplay;
    public TextMeshProUGUI rangedDisplay;

    private int level = 1;
    private float totalDamage = 0, baseDamage = 20f;
    private int attackCount = 0;

    private string weaponName;
    private float stdDevMult, critRate, critMult;

    // --- 새로 추가된 통계 변수들 ---
    private int weaknessCount = 0;
    private int missCount = 0;
    private int totalCritCount = 0;
    private float maxDamage = 0f;

    void Start()
    {
        SetWeapon(0); // 시작 시 단검 장착
    }

    private void ResetData()
    {
        totalDamage = 0;
        attackCount = 0;
        level = 1;
        baseDamage = 20f;

        // 무기 교체 시 통계도 초기화
        weaknessCount = 0;
        missCount = 0;
        totalCritCount = 0;
        maxDamage = 0f;
    }

    public void SetWeapon(int id)
    {
        ResetData();
        if (id == 0)
        {
            SetStats("단검", 0.1f, 0.4f, 1.5f);
        }
        else if (id == 1)
        {
            SetStats("장검", 0.2f, 0.3f, 2.0f);
        }
        else
        {
            SetStats("도끼", 0.3f, 0.2f, 3.0f);
        }

        logDisplay.text = string.Format("{0} 장착!", weaponName);
        UpdateUI();
    }

    private void SetStats(string _name, float _stdDev, float _critRate, float _critMult)
    {
        weaponName = _name;
        stdDevMult = _stdDev;
        critRate = _critRate;
        critMult = _critMult;
    }

    public void LevelUp()
    {
        totalDamage = 0;
        attackCount = 0;
        level++;
        baseDamage = level * 20f;

        // 레벨업 시 통계 초기화
        weaknessCount = 0;
        missCount = 0;
        totalCritCount = 0;
        maxDamage = 0f;

        logDisplay.text = string.Format("레벨업! 현재 레벨: {0}", level);
        UpdateUI();
    }

    // 1회 공격 버튼용 메서드
    public void OnAttack()
    {
        ExecuteAttack(out float finalDamage, out string logMsg);
        logDisplay.text = logMsg;
        UpdateUI();
    }

    // --- 새로 추가된 1000회 연속 공격 버튼용 메서드 ---
    public void OnAttack1000()
    {
        for (int i = 0; i < 1000; i++)
        {
            ExecuteAttack(out _, out _);
        }

        logDisplay.text = "1000회 연속 공격 완료!";
        UpdateUI();
    }

    // 공격 판정 및 계산을 담당하는 공통 로직 (중복 코드 방지)
    private void ExecuteAttack(out float finalDamage, out string logMsg)
    {
        float sd = baseDamage * stdDevMult;
        float normalDamage = GetNormalStdDevDamage(baseDamage, sd);

        // 2σ(표준편차) 기준 명중 실패 및 약점 공격 판정
        bool isMiss = normalDamage < (baseDamage - 2 * sd);
        bool isWeakness = normalDamage > (baseDamage + 2 * sd);
        bool isCrit = Random.value < critRate;

        finalDamage = 0f;
        logMsg = "";

        if (isMiss)
        {
            // 명중 실패: 데미지 0
            missCount++;
            finalDamage = 0f;
            logMsg = "<color=grey>[명중 실패!]</color> 데미지: 0";
        }
        else
        {
            // 정상 명중
            float currentDamage = normalDamage;
            string prefix = "";

            if (isWeakness)
            {
                weaknessCount++;
                currentDamage *= 2f; // 약점 공격 시 데미지 2배
                prefix += "<color=orange>[약점 공격!]</color> ";
            }

            if (isCrit)
            {
                totalCritCount++;
                currentDamage *= critMult; // 치명타 곱연산 적용
                prefix += "<color=red>[치명타!]</color> ";
            }

            finalDamage = currentDamage;
            logMsg = string.Format("{0}데미지: {1:F1}", prefix, finalDamage);
        }

        // 최대 데미지 기록 갱신
        if (finalDamage > maxDamage)
        {
            maxDamage = finalDamage;
        }

        // 통계 누적
        attackCount++;
        totalDamage += finalDamage;
    }

    private void UpdateUI()
    {
        statusDisplay.text = string.Format("Level: {0} / 무기: {1}\n기본 데미지: {2} / 치명타: {3}% (x{4})",
            level, weaponName, baseDamage, critRate * 100, critMult);

        rangedDisplay.text = string.Format("예상 일반 데미지 범위 : [{0:F1} ~ {1:F1}]",
            baseDamage - (3 * baseDamage * stdDevMult),
            baseDamage + (3 * baseDamage * stdDevMult));

        float dpa = attackCount > 0 ? totalDamage / attackCount : 0;

        // --- 통계 요약 정보가 Result Display에 표시되도록 추가 ---
        resultDisplay.text = string.Format("누적 데미지: {0:F1}\n공격 횟수: {1}\n평균 DPA: {2:F2}\n\n<color=#FFFF00>[통계 정보]</color>\n약점 공격: {3}회\n명중 실패: {4}회\n치명타 발생: {5}회\n최대 데미지: {6:F1}",
            totalDamage, attackCount, dpa, weaknessCount, missCount, totalCritCount, maxDamage);
    }

    private float GetNormalStdDevDamage(float mean, float stdDev)
    {
        float u1 = 1.0f - Random.value;
        float u2 = 1.0f - Random.value;
        float randStdNormal = Mathf.Sqrt(-2.0f * Mathf.Log(u1)) * Mathf.Sin(2.0f * Mathf.PI * u2);
        return mean + stdDev * randStdNormal;
    }
}
